    },
    {
      "id": "e5",
      "from": "permanent",
      "to": "skip",
      "label": "不重试",
      "role": "error"
    },
    {
      "id": "e6",
      "from": "guard",
      "to": "inject",
      "label": "冷却后未达上限",
      "role": "main"
    },
    {
      "id": "e7",
      "from": "guard",
      "to": "skip",
      "label": "达上限 · 循环守卫 · 已暂停",
      "role": "branch"
    },
    {
      "id": "e8",
      "from": "inject",
      "to": "resume",
      "label": "注入恢复指令",
      "role": "main"
    },
    {
      "id": "e9",
      "from": "resume",
      "to": "turn_end",
      "label": "下一回合结束再检查",
