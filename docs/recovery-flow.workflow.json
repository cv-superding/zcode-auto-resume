    "views": [
      {
        "id": "auto-resume",
        "label": "自动恢复主链",
        "focus": [
          "turn_end",
          "collect",
          "classify",
          "guard",
          "inject",
          "resume"
        ],
        "note": "临时性故障从检测到注入继续指令的完整主链。"
      },
      {
        "id": "give-up",
        "label": "放弃出口",
        "focus": [
          "classify",
          "permanent",
          "guard",
          "skip"
        ],
        "note": "重试无益或达到上限时如实放行，绝不空转。"
      }
    ],
    "output": "docs/recovery-flow.html"
  },
