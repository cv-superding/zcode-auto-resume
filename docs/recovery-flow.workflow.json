    {
      "id": "classify",
      "label": "分类",
      "fromCol": 2,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "recover",
      "label": "恢复",
      "fromCol": 4,
      "toCol": 5
    }
  ],
  "groups": [
    {
      "id": "engine",
