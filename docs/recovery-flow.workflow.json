  "edges": [
    {
      "id": "e1",
      "from": "turn_end",
      "to": "collect",
      "label": "Stop 触发",
      "role": "main"
    },
    {
      "id": "e2",
      "from": "collect",
      "to": "classify",
      "label": "文本证据",
      "role": "main"
    },
    {
      "id": "e3",
      "from": "classify",
      "to": "permanent",
      "label": "401/403 · 余额 · 模型 · 上下文超限",
